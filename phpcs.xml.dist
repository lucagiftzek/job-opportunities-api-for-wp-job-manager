<?xml version="1.0"?>
<ruleset name="JOAWPJM">
	<description>WordPress Coding Standards for Job Opportunities API for WP Job Manager.</description>
	<file>job-opportunities-api-for-wp-job-manager</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="job-opportunities-api-for-wp-job-manager"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="joawpjm"/>
				<element value="JOAWPJM"/>
			</property>
		</properties>
	</rule>
	<!-- Class files follow the WordPress "class-*.php" naming. -->
</ruleset>
